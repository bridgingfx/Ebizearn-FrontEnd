<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Canonical domain: force https + apex (no www) so search engines see one URL.
    # NOTE: this file is currently excluded from the FTPS deploy (see
    # .github/workflows/deploy.yml `exclude`). These rules take effect on
    # ebizearn.com only once the exclude is removed or they are added in cPanel.
    RewriteCond %{HTTP_HOST} ^www\.ebizearn\.com$ [NC]
    RewriteRule ^(.*)$ https://ebizearn.com/$1 [L,R=301]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # SPA fallback: serve real files/dirs first, everything else → index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.html [L]
</IfModule>

# Fresh deploys without a cache clear: the HTML shell and version.json are
# always re-checked; hashed /assets/* files never change, so cache them hard.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
